# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# AI demand model service
DEMAND_MODEL_URL=http://localhost:8000
DEMAND_MODEL_API_KEY=replace-with-a-service-secret
DEMAND_MODEL_TIMEOUT_MS=15000

# Gemini merchandising explanations and campaign copy
GEMINI_API_KEY=replace-with-a-restricted-server-key
GEMINI_MODEL=gemini-2.5-flash
MAX_GEMINI_PRODUCTS_PER_SCAN=20

# Brevo Email
BREVO_API_KEY=xkeysib-...
BREVO_TIER1_TEMPLATE_ID=1
BREVO_TIER2_TEMPLATE_ID=2
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=FreshSaver Deals

# Vercel Cron (auto-injected by Vercel; set manually for local testing)
CRON_SECRET=your-random-secret-string

# App Config
NEXT_PUBLIC_STORE_URL=https://yourstore.com

# One-click judge access (server-only; create these users in Supabase Auth first)
DEMO_STORE_OWNER_EMAIL=demo-owner@example.com
DEMO_STORE_OWNER_PASSWORD=replace-with-a-strong-demo-password
DEMO_CUSTOMER_EMAIL=demo-customer@example.com
DEMO_CUSTOMER_PASSWORD=replace-with-a-strong-demo-password

# Map tiles (free OpenStreetMap — no API key needed)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# Note: NEXT_PUBLIC_STORE_NAME is deprecated — store names are managed in the DB
