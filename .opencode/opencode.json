{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-supabase"
  ],
  "mcp": {
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.supabase.com/mcp?project_ref=kozxbwyokqpgwaqrbgyg",
        "--transport",
        "http-only"
      ],
      "enabled": true
    },
    "render": {
      "type": "local",
      "command": [
        "node",
        "--env-file=.env.local",
        "scripts/render-mcp-wrapper.mjs"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 120000
  }
}
